{
  "version": "2.0.4",
  "tasks": [
    {
      "label": "Compile Clean",
      "type": "shell",
      "command": "arduino-cli compile --clean --fqbn esp32:esp32:esp32s3 ./De-kleine-kas.ino",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "OTA Upload",
      "type": "shell",
      "command": "for i in {1..10}; do python3 ~/.arduino15/packages/esp32/hardware/esp32/3.3.12/tools/espota.py -i 192.168.2.1 -p 3232 -r -f ./build/build_ESP32-S3-Zero-N8R8-M/De-kleine-kas.ino.bin && exit 0; sleep 3; done; exit 1",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Connect TCP Monitor",
      "type": "shell",
      "command": "echo 'START' | nc 192.168.1.158 2",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Full OTA & Monitor Pipeline",
      "dependsOn": [
        "Compile Clean",
        "OTA Upload",
        "Connect TCP Monitor"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}